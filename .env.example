NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase
SUPABASE_URL=<your-supabase-url>.supabase.co
SUPABASE_ANON_KEY=<your-anon-key>

# LLM Inference Provider API Keys (OpenAI-compatible)
GROQ_API_KEY=<your-groq-api-key>       # primary, free: https://console.groq.com
GEMINI_API_KEY=<your-gemini-api-key>   # fallback, free: https://aistudio.google.com/apikey

# Upstash - Rate Limiting
UPSTASH_REDIS_REST_URL=<your-redis-url>
UPSTASH_REDIS_REST_TOKEN=<your-redis-token>